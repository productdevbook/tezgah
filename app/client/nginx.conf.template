server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    # The panel's default is VITE_TEZGAH_API=/api; this strips the /api
    # prefix back off before handing the request to tezgah-server, whose own
    # routes start at /admin and /store.
    location /api/ {
        proxy_pass http://${TEZGAH_API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
