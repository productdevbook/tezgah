# Copy this to .env and change the values marked "change this" before
# running `docker compose up -d`. docker-compose.yml reads every variable
# here; none of it is read by tezgah itself except DATABASE_URL, PORT,
# ADMIN_TOKEN and TEZGAH_DEMO_BANK, which it builds or passes through for
# the tezgah-server container.

# --- Postgres ---
# The database user, password and name tezgah-server's own DATABASE_URL is
# built from. Postgres creates the user and database the first time the
# postgres_data volume is empty; changing these afterwards renames nothing.
POSTGRES_USER=tezgah
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=tezgah

# --- tezgah-server ---
# Bearer token the admin surface requires on every /admin/* request. Leave
# this unset (or empty) and tezgah-server does not serve /admin/* at all —
# no admin surface with a weak or missing token, rather than one guessable.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=change-this-to-a-generated-token

# tezgah-server ships one payment provider: a demo that authorises every
# charge immediately and remembers nothing. Leave this unset (or empty) and
# checkout is not bound at all — nothing to accept a payment against, real or
# fake. Setting it to exactly "i-understand-this-takes-no-money" is what
# turns checkout on against that demo; anything else, including any other
# text, is treated the same as unset. See docs/self-hosting.md for what
# taking real money instead requires.
TEZGAH_DEMO_BANK=

# The port tezgah-server listens on inside its own container. The compose
# file also uses this to reach it from tezgah-panel and to publish it on the
# host, so change it here rather than in docker-compose.yml.
SERVER_PORT=8080

# --- Host ports ---
# Where each service answers on the machine you run compose on.
SERVER_HTTP_PORT=8081
PANEL_HTTP_PORT=8080

# --- Image tag ---
# ghcr.io/productdevbook/tezgah-server and tezgah-panel are published as:
# a version tag (e.g. 1.2.3), its minor (1.2), "latest" for the newest
# tagged release, and "edge" for the tip of main. Pin a real deployment to
# a version tag rather than "latest", which moves under you on every release.
TEZGAH_VERSION=latest
